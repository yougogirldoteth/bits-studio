# Copy to .env.local for local development.

# One or more Ethereum mainnet HTTP RPC URLs, separated by spaces or commas.
# Use a private RPC endpoint for reliable indexing.
PONDER_RPC_URLS_1=https://eth.drpc.org

# Optional fallback RPCs, separated by spaces or commas.
PONDER_RPC_FALLBACK_URLS_1=

# Optional websocket RPC for live indexing.
PONDER_WS_URL_1=

# Local Postgres for Ponder.
DATABASE_URL=postgres://ponder_indexer:local-password@localhost:5432/ponder
DATABASE_SCHEMA=bits_indexer
PONDER_VIEWS_SCHEMA=bits_indexer

# Deployment only: bootstrap/maintenance identity, never used in DATABASE_URL.
# Existing clusters initialized with ponder must retain POSTGRES_ADMIN_USER=ponder.
POSTGRES_ADMIN_USER=ponder_admin
# POSTGRES_PASSWORD is the separate administrator password, supplied by secrets.
