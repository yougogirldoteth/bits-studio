# Copy to .env for local development.

# URL of the Ponder indexer REST API.
NUXT_PUBLIC_BITS_INDEXER_URL=http://localhost:42069

# Currently supported value: mainnet.
NUXT_PUBLIC_BITS_INDEXER_CHAIN=mainnet

# Optional WalletConnect project id. Injected wallets work without this.
NUXT_PUBLIC_EVM_WALLET_CONNECT_PROJECT_ID=

# Space-separated Ethereum mainnet RPC URLs. Use a private RPC for production.
NUXT_PUBLIC_EVM_CHAINS_MAINNET_RPCS=https://eth.drpc.org
